{
  "seed": 42,
  "split_ratios": [0.7, 0.2, 0.1],
  "model": "efficientnet_b0",
  "weights": "IMAGENET1K_V1",
  "waste_classes": ["general", "glass", "food_waste", "other_recycling"],
  "residual_classes": ["none", "food", "liquid", "not_assessable"],
  "input_size": 224,
  "dropout": 0.2,
  "batch_size": 8,
  "num_workers": 0,
  "backbone_lr": 0.00001,
  "head_lr": 0.0001,
  "weight_decay": 0.0001,
  "max_epochs": 30,
  "patience": 5,
  "min_delta": 0.0,
  "amp": false,
  "device": "cuda",
  "preprocessing": "letterbox_bicubic_224_imagenet_normalize",
  "horizontal_flip": 0.5,
  "brightness_contrast": 0.05,
  "confidence_threshold": 0.6,
  "eval_plan": ["stage1_best", "stage2_best"],
  "allow_weight_download": false
}
